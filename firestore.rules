rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users / Auxiliadora Media Accounts
    match /users/{userId} {
      allow read, write: if true;
    }

    // Account Applicants
    match /applicants/{applicantId} {
      allow read, write: if true;
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read, write: if true;
    }

    // Schedules
    match /schedules/{scheduleId} {
      allow read, write: if true;
    }

    // Site & Ministry Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Server Notes & Reminders
    match /server_notes/{noteId} {
      allow read, write: if true;
    }

    // Substitution Requests
    match /sub_requests/{requestId} {
      allow read, write: if true;
    }

    // Service Receipts & Logs
    match /receipts/{receiptId} {
      allow read, write: if true;
    }

    // Attendance Audit Records
    match /audit_records/{recordId} {
      allow read, write: if true;
    }

    // Sub-Admin Attendance Alerts
    match /subadmin_alerts/{alertId} {
      allow read, write: if true;
    }

    // Active Sessions
    match /active_sessions/{sessionId} {
      allow read, write: if true;
    }

    // Connection test document
    match /test/{documentId} {
      allow read, write: if true;
    }
  }
}
